<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textColor="@color/textMain"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvService"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/textSub"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvLockState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/textMain"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvInterval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/textSub"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvBank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/textSub"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvBankDir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/textSub"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/setup_phone_label"
            android:textColor="@color/textSub"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvUrlLocal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="http://tvlock.local:8080"
            android:textColor="@color/accent"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUrlIp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/textMain"
            android:textSize="26sp" />

        <ImageView
            android:id="@+id/ivQr"
            android:layout_width="400dp"
            android:layout_height="400dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:contentDescription="二维码" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/setup_tip"
            android:textColor="@color/textSub"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTestLock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_btn"
                android:padding="16dp"
                android:text="@string/setup_test_lock"
                android:textColor="@color/textMain"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnUnlock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn"
                android:padding="16dp"
                android:text="@string/setup_unlock"
                android:textColor="@color/textMain"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnAdmin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn"
                android:padding="16dp"
                android:text="@string/setup_admin_off"
                android:textColor="@color/textMain"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setup_autostart_note"
            android:textColor="@color/textSub"
            android:textSize="16sp" />
    </LinearLayout>
    </ScrollView>

    <!-- 首次启动引导：管理码设置浮层（遥控器数字键输入，无需输入法） -->
    <LinearLayout
        android:id="@+id/pinOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC101018"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置电视端管理码"
            android:textColor="@color/textMain"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPinShow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="____"
            android:textColor="@color/accent"
            android:textSize="64sp"
            android:textStyle="bold" />

        <!-- 屏幕数字键盘（遥控器无数字键时用方向键+OK操作） -->
        <GridLayout
            android:id="@+id/gridPinPad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:columnCount="3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="请设置 4 位新管理码（不能用默认的 1234）\n家长解锁电视时使用，请牢记"
            android:textColor="@color/textSub"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="有数字键的遥控器也可直接按数字键输入，返回键退格"
            android:textColor="@color/textSub"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>
